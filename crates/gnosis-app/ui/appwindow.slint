import { Theme } from "theme.slint";
export { Theme }
import { Sidebar, TreeItemData } from "sidebar.slint";
import { StatusBar } from "statusbar.slint";
import { TabBar, TabData } from "tabbar.slint";
import { QuickSwitcherModal, QuickItemData } from "quick_switcher.slint";
import { RichViewer, RenderBlockData } from "rich_viewer.slint";
import { GraphCanvas, GraphNodeSlint, GraphEdgeSlint } from "graph_canvas.slint";
import { SyncModal, PeerData } from "sync_modal.slint";

export component AppWindow inherits Window {
    title: "Gnosis";
    preferred-width: 1024px;
    preferred-height: 700px;
    min-width: 640px;
    min-height: 400px;
    background: Theme.background;

    // Propriedades do Vault e Arquivos
    in property <string> vault_name: "Meu Vault";
    in property <[TreeItemData]> file_tree: [];
    in-out property <bool> sidebar_collapsed: false;

    // Propriedades do Editor e Modo de Visualização
    in property <string> active_note_title: "Boas-vindas ao Gnosis";
    in property <string> active_note_icon: "";
    in property <string> active_note_content: "# Bem-vindo ao Gnosis\n\nRecompilação de alto desempenho do Obsidian em Rust puro.";
    in property <bool> is_editing: false;

    in property <[RenderBlockData]> ast_blocks: [];

    // Propriedades da Visualização do Grafo 2D
    in property <bool> is_graph_view: false;
    in property <[GraphNodeSlint]> graph_nodes: [];
    in property <[GraphEdgeSlint]> graph_edges: [];
    in property <bool> graph_is_sleeping: false;
    in property <bool> graph_hide_orphans: false;
    in property <bool> graph_hide_unresolved: false;

    // Propriedades do Painel Secundário (Split View)
    in property <bool> is_split: false;
    in property <string> secondary_note_title: "Nota Dividida";
    in property <string> secondary_note_content: "Este painel está em modo Split View lado a lado.";

    // Propriedades de Abas e Histórico
    in property <[TabData]> tabs: [];
    in property <bool> can_go_back: false;
    in property <bool> can_go_forward: false;

    // Propriedades do Quick Switcher / Paleta de Comandos
    in property <bool> quick_switcher_open: false;
    in property <string> quick_switcher_placeholder: "Digite para buscar uma nota (Ctrl+O)...";
    in property <[QuickItemData]> quick_items: [];
    in property <int> quick_selected_index: 0;

    // Propriedades do Modal de Sincronização P2P
    in property <bool> sync_modal_open: false;
    in property <bool> sync_modal_connected: false;
    in property <string> sync_modal_room_code: "";
    in property <string> sync_modal_status: "Pronto para conectar.";
    in property <[PeerData]> sync_modal_peers: [];

    // Propriedades da Barra de Status
    in property <string> sync_status: "Sincronizado (Local)";
    in property <color> sync_color: Theme.success;
    in property <int> word_count: 14;
    in property <int> char_count: 85;

    // Callbacks para eventos do usuário
    callback note_selected(string);
    callback folder_toggled(string);
    callback toggle_sidebar();
    callback new_note_requested();
    callback content_changed(string);

    // Callbacks do Editor
    callback toggle_editor_mode();
    callback note_text_edited(string);
    callback task_checkbox_toggled(int);

    // Callbacks do Grafo 2D
    callback toggle_graph_view();
    callback graph_node_clicked(string);
    callback graph_node_dragged(string, float, float);
    callback graph_node_released(string);
    callback graph_restart_physics();
    callback graph_toggle_hide_orphans();
    callback graph_toggle_hide_unresolved();
    callback graph_zoom_in();
    callback graph_zoom_out();

    // Callbacks de Abas, Split e Histórico
    callback tab_selected(int);
    callback tab_closed(int);
    callback go_back();
    callback go_forward();
    callback toggle_split();
    callback new_tab();

    // Callbacks do Tema
    callback cycle_theme();

    // Callbacks do Quick Switcher
    callback open_quick_switcher(string);
    callback quick_query_changed(string);
    callback quick_item_clicked(int);
    callback quick_close_requested();

    // Callbacks de Sincronização P2P e Salas
    callback open_sync_modal();
    callback sync_join_room(string);
    callback sync_generate_code();
    callback sync_leave_room();
    callback sync_close_modal();

    // Layout Principal
    VerticalLayout {
        spacing: 0px;

        // Área Central (Barra Lateral + Abas + Editor / Grafo / Split)
        HorizontalLayout {
            vertical-stretch: 1;
            spacing: 0px;

            // Barra Lateral de Arquivos
            Sidebar {
                vault_title: root.vault_name;
                items: root.file_tree;
                is_collapsed: root.sidebar_collapsed;

                note_clicked(path) => { root.note_selected(path); }
                folder_toggled(path) => { root.folder_toggled(path); }
                toggle_sidebar => { root.toggle_sidebar(); }
                new_note_requested => { root.new_note_requested(); }
            }

            // Botão de reabertura da barra lateral quando recolhida
            if (root.sidebar_collapsed): Rectangle {
                width: 28px;
                background: Theme.sidebar_bg;

                Rectangle {
                    x: parent.width - 1px;
                    width: 1px;
                    height: 100%;
                    background: Theme.border;
                }

                Text {
                    text: "▶";
                    color: Theme.text_muted;
                    font-size: 11px;
                    vertical-alignment: center;
                    horizontal-alignment: center;
                }

                TouchArea {
                    clicked => { root.toggle_sidebar(); }
                }
            }

            // Área Central de Trabalho (Abas no topo + Conteúdo / Grafo)
            VerticalLayout {
                horizontal-stretch: 1;
                spacing: 0px;

                // Barra de Abas Superiores
                TabBar {
                    tabs: root.tabs;
                    can_go_back: root.can_go_back;
                    can_go_forward: root.can_go_forward;
                    is_split: root.is_split;

                    tab_selected(idx) => { root.tab_selected(idx); }
                    tab_closed(idx) => { root.tab_closed(idx); }
                    go_back => { root.go_back(); }
                    go_forward => { root.go_forward(); }
                    toggle_split => { root.toggle_split(); }
                    new_tab => { root.new_tab(); }
                }

                // Barra de Controle Superior do Painel
                Rectangle {
                    height: 42px;
                    background: Theme.background;

                    Rectangle {
                        y: parent.height - 1px;
                        height: 1px;
                        width: 100%;
                        background: Theme.border;
                    }

                    HorizontalLayout {
                        padding-left: 16px;
                        padding-right: 16px;
                        alignment: space-between;

                        // Título da Nota ou do Grafo com Ícone/Sticker
                        HorizontalLayout {
                            spacing: 8px;
                            alignment: start;

                            if (!root.is_graph_view && root.active_note_icon != ""): Text {
                                text: root.active_note_icon;
                                font-size: 18px;
                                vertical-alignment: center;
                            }

                            Text {
                                text: root.is_graph_view ? "🕸️ Grafo de Conhecimento Global" : root.active_note_title;
                                color: Theme.text_primary;
                                font-size: 16px;
                                font-weight: 700;
                                vertical-alignment: center;
                            }
                        }


                        // Ações Rápidas: Alternar Grafo, Alternar Edição/Leitura e Quick Switcher
                        HorizontalLayout {
                            spacing: 8px;
                            alignment: end;

                            // Botão Alternar Visualização do Grafo (Ctrl+G)
                            Rectangle {
                                width: 110px;
                                height: 28px;
                                border-radius: 4px;
                                background: root.is_graph_view ? Theme.surface_active : Theme.surface;
                                border-width: 1px;
                                border-color: root.is_graph_view ? Theme.accent : Theme.border;
                                y: (parent.height - self.height) / 2;

                                HorizontalLayout {
                                    alignment: center;
                                    spacing: 6px;

                                    Text {
                                        text: root.is_graph_view ? "📝 Notas" : "🕸️ Grafo";
                                        color: root.is_graph_view ? Theme.accent : Theme.text_primary;
                                        font-size: 11px;
                                        font-weight: 600;
                                        vertical-alignment: center;
                                    }

                                    Text {
                                        text: "(Ctrl+G)";
                                        color: Theme.text_muted;
                                        font-size: 10px;
                                        vertical-alignment: center;
                                    }
                                }

                                TouchArea {
                                    clicked => { root.toggle_graph_view(); }
                                }
                            }

                            // Botão Alternar Edição / Leitura (apenas se não estiver no Grafo)
                            if (!root.is_graph_view): Rectangle {
                                width: 120px;
                                height: 28px;
                                border-radius: 4px;
                                background: Theme.surface;
                                border-width: 1px;
                                border-color: root.is_editing ? Theme.accent : Theme.border;
                                y: (parent.height - self.height) / 2;

                                HorizontalLayout {
                                    alignment: center;
                                    spacing: 6px;

                                    Text {
                                        text: root.is_editing ? "✏️ Edição" : "👁️ Leitura";
                                        color: root.is_editing ? Theme.accent : Theme.text_primary;
                                        font-size: 11px;
                                        font-weight: 600;
                                        vertical-alignment: center;
                                    }

                                    Text {
                                        text: "(Ctrl+E)";
                                        color: Theme.text_muted;
                                        font-size: 10px;
                                        vertical-alignment: center;
                                    }
                                }

                                TouchArea {
                                    clicked => { root.toggle_editor_mode(); }
                                }
                            }

                            // Botão de Atalho para o Quick Switcher
                            Rectangle {
                                width: 110px;
                                height: 28px;
                                border-radius: 4px;
                                background: Theme.surface;
                                border-width: 1px;
                                border-color: Theme.border;
                                y: (parent.height - self.height) / 2;

                                HorizontalLayout {
                                    padding-left: 8px;
                                    padding-right: 8px;
                                    spacing: 6px;
                                    alignment: center;

                                    Text {
                                        text: "🔍 Buscar (Ctrl+O)";
                                        color: Theme.text_muted;
                                        font-size: 10px;
                                        vertical-alignment: center;
                                    }
                                }

                                TouchArea {
                                    clicked => { root.open_quick_switcher("files"); }
                                }
                            }
                        }
                    }
                }

                // Corpo Central: Canvas do Grafo 2D OU Editores de Nota
                if (root.is_graph_view): GraphCanvas {
                    vertical-stretch: 1;
                    nodes: root.graph_nodes;
                    edges: root.graph_edges;
                    is_sleeping: root.graph_is_sleeping;
                    hide_orphans: root.graph_hide_orphans;
                    hide_unresolved: root.graph_hide_unresolved;

                    node_clicked(id) => { root.graph_node_clicked(id); }
                    node_dragged(id, x, y) => { root.graph_node_dragged(id, x, y); }
                    node_released(id) => { root.graph_node_released(id); }
                    restart_physics => { root.graph_restart_physics(); }
                    toggle_hide_orphans => { root.graph_toggle_hide_orphans(); }
                    toggle_hide_unresolved => { root.graph_toggle_hide_unresolved(); }
                    zoom_in => { root.graph_zoom_in(); }
                    zoom_out => { root.graph_zoom_out(); }
                }

                if (!root.is_graph_view): HorizontalLayout {
                    vertical-stretch: 1;
                    spacing: 0px;

                    // Painel Principal
                    Rectangle {
                        horizontal-stretch: 1;
                        background: Theme.background;

                        VerticalLayout {
                            padding: 0px;
                            spacing: 0px;

                            if (root.is_editing): Rectangle {
                                vertical-stretch: 1;
                                background: Theme.background;

                                Flickable {
                                    vertical-stretch: 1;

                                    VerticalLayout {
                                        padding: 16px;

                                        editor_input := TextInput {
                                            text: root.active_note_content;
                                            color: Theme.text_primary;
                                            font-size: 14px;
                                            single-line: false;
                                            wrap: word-wrap;

                                            edited => {
                                                root.note_text_edited(self.text);
                                            }
                                        }
                                    }
                                }
                            }

                            if (!root.is_editing): RichViewer {
                                vertical-stretch: 1;
                                blocks: root.ast_blocks;
                                task_toggled(idx) => { root.task_checkbox_toggled(idx); }
                            }
                        }
                    }

                    // Painel Secundário se Split View Ativo
                    if (root.is_split): HorizontalLayout {
                        horizontal-stretch: 1;
                        spacing: 0px;

                        Rectangle {
                            width: 1px;
                            background: Theme.border;
                        }

                        Rectangle {
                            horizontal-stretch: 1;
                            background: Theme.background;

                            VerticalLayout {
                                padding: 16px;
                                spacing: 12px;

                                HorizontalLayout {
                                    height: 32px;
                                    alignment: space-between;

                                    Text {
                                        text: root.secondary_note_title;
                                        color: Theme.text_primary;
                                        font-size: 18px;
                                        font-weight: 700;
                                        vertical-alignment: center;
                                    }
                                }

                                Rectangle {
                                    height: 1px;
                                    background: Theme.border;
                                }

                                Flickable {
                                    vertical-stretch: 1;

                                    Text {
                                        text: root.secondary_note_content;
                                        color: Theme.text_secondary;
                                        font-size: 14px;
                                        wrap: word-wrap;
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }

        // Barra de Status Inferior
        StatusBar {
            vault_name: root.vault_name;
            sync_status: root.sync_status;
            sync_color: root.sync_color;
            word_count: root.word_count;
            char_count: root.char_count;
            theme_clicked => { root.cycle_theme(); }
            sync_clicked => { root.open_sync_modal(); }
        }
    }

    // Modal Suspenso Flutuante (Quick Switcher e Paleta de Comandos)
    QuickSwitcherModal {
        is_open: root.quick_switcher_open;
        placeholder_text: root.quick_switcher_placeholder;
        items: root.quick_items;
        selected_index: root.quick_selected_index;

        query_changed(q) => { root.quick_query_changed(q); }
        item_clicked(idx) => { root.quick_item_clicked(idx); }
        close_requested => { root.quick_close_requested(); }
    }

    // Modal Suspenso Flutuante (Sincronização P2P e Salas Colaborativas)
    SyncModal {
        is_open: root.sync_modal_open;
        is_connected: root.sync_modal_connected;
        room_code: root.sync_modal_room_code;
        status_message: root.sync_modal_status;
        peers: root.sync_modal_peers;

        join_room_requested(code) => { root.sync_join_room(code); }
        generate_code_requested => { root.sync_generate_code(); }
        leave_room_requested => { root.sync_leave_room(); }
        close_modal => { root.sync_close_modal(); }
    }
}
