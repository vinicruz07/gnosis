import { Theme } from "theme.slint";

export struct TreeItemData {
    id: string,
    name: string,
    path: string,
    is_folder: bool,
    is_expanded: bool,
    indent_level: int,
    is_active: bool,
    icon: string,
}

export component Sidebar inherits Rectangle {
    in property <string> vault_title: "Meu Vault";
    in property <[TreeItemData]> items: [];
    in property <bool> is_collapsed: false;

    callback note_clicked(string);
    callback folder_toggled(string);
    callback toggle_sidebar();
    callback new_note_requested();
    callback new_membrane_requested();
    callback new_folder_requested(string, string);
    callback item_moved(string, string);
    callback item_context_menu(string, bool, length, length);
    callback sidebar_bg_context_menu(length, length);
    callback settings_clicked();
    callback grimoire_clicked();

    // Estado para criação de pastas/subpastas
    in-out property <bool> is_creating_folder: false;
    in-out property <string> pending_folder_parent: "";
    private property <string> pending_folder_name: "";

    // Estado interno para Drag & Drop de arquivos/pastas
    private property <string> drag_source_path: "";
    private property <string> drag_source_name: "";
    private property <bool> drag_active: false;
    private property <bool> suppress_next_click: false;
    private property <length> drag_start_y: 0px;
    private property <length> drag_current_y: 0px;
    private property <string> drop_target_folder: "";

    function open_folder_creator(parent_path: string) {
        root.pending_folder_parent = parent_path;
        root.pending_folder_name = "";
        root.is_creating_folder = true;
        folder_name_input.focus();
    }

    function submit_folder_creator() {
        if (root.pending_folder_name != "") {
            root.new_folder_requested(root.pending_folder_parent, root.pending_folder_name);
        }
        root.is_creating_folder = false;
        root.pending_folder_name = "";
        root.pending_folder_parent = "";
    }

    background: Theme.sidebar_bg;
    width: root.is_collapsed ? 0px : 240px;
    animate width { duration: 150ms; easing: ease-out; }

    // Divisória vertical direita
    Rectangle {
        x: parent.width - 1px;
        width: 1px;
        height: 100%;
        background: Theme.border;
    }

    VerticalLayout {
        padding: 8px;
        spacing: 6px;

        // Cabeçalho da Barra Lateral (Identidade do Grimório + Ações Rápidas)
        HorizontalLayout {
            height: 28px;
            alignment: space-between;

            // Seletor Interativo do Grimório Ativo
            Rectangle {
                border-radius: 4px;
                background: touch_grimoire_title.has-hover ? Theme.surface_hover : transparent;

                touch_grimoire_title := TouchArea {
                    mouse-cursor: pointer;
                    clicked => { root.grimoire_clicked(); }
                }

                HorizontalLayout {
                    padding-left: 4px;
                    padding-right: 6px;
                    spacing: 4px;
                    alignment: start;

                    Text {
                        text: "📖";
                        font-size: 13px;
                        vertical-alignment: center;
                    }

                    Text {
                        text: root.vault_title;
                        color: touch_grimoire_title.has-hover ? Theme.accent : Theme.text_primary;
                        font-size: 13px;
                        font-weight: 600;
                        vertical-alignment: center;
                        overflow: elide;
                    }

                    Text {
                        text: "▾";
                        color: Theme.text_muted;
                        font-size: 10px;
                        vertical-alignment: center;
                    }
                }
            }

            HorizontalLayout {
                spacing: 4px;
                alignment: end;

                // Botão Nova Membrana / Pergaminho (📜)
                Rectangle {
                    width: 24px;
                    height: 24px;
                    border-radius: 4px;
                    background: touch_new_membrane.has-hover ? Theme.surface_hover : transparent;

                    Text {
                        text: "📜";
                        font-size: 11px;
                        vertical-alignment: center;
                        horizontal-alignment: center;
                    }

                    touch_new_membrane := TouchArea {
                        mouse-cursor: pointer;
                        clicked => { root.new_membrane_requested(); }
                    }
                }

                // Botão Nova Pasta (na raiz)
                Rectangle {
                    width: 24px;
                    height: 24px;
                    border-radius: 4px;
                    background: touch_new_folder.has-hover ? Theme.surface_hover : transparent;

                    Text {
                        text: "📁";
                        font-size: 11px;
                        vertical-alignment: center;
                        horizontal-alignment: center;
                    }

                    touch_new_folder := TouchArea {
                        mouse-cursor: pointer;
                        clicked => { root.open_folder_creator(""); }
                    }
                }

                // Botão Nova Nota (ao lado do nome do Grimório)
                Rectangle {
                    width: 24px;
                    height: 24px;
                    border-radius: 4px;
                    background: touch_new.has-hover ? Theme.surface_hover : transparent;

                    Text {
                        text: "➕";
                        font-size: 11px;
                        vertical-alignment: center;
                        horizontal-alignment: center;
                    }

                    touch_new := TouchArea {
                        mouse-cursor: pointer;
                        clicked => { root.new_note_requested(); }
                    }
                }

                // Botão Recolher Barra Lateral
                Rectangle {
                    width: 24px;
                    height: 24px;
                    border-radius: 4px;
                    background: touch_collapse.has-hover ? Theme.surface_hover : transparent;

                    Text {
                        text: "◀";
                        color: Theme.text_muted;
                        font-size: 10px;
                        vertical-alignment: center;
                        horizontal-alignment: center;
                    }

                    touch_collapse := TouchArea {
                        mouse-cursor: pointer;
                        clicked => { root.toggle_sidebar(); }
                    }
                }
            }
        }

        // Divisor sutil
        Rectangle {
            height: 1px;
            background: Theme.border;
        }

        // Barra inline para criação de Pasta / Subpasta
        Rectangle {
            visible: root.is_creating_folder;
            height: root.is_creating_folder ? 58px : 0px;
            clip: true;
            background: Theme.surface;
            border-radius: 6px;
            border-width: root.is_creating_folder ? 1px : 0px;
            border-color: Theme.accent;

            VerticalLayout {
                padding: 6px;
                spacing: 4px;

                Text {
                    text: root.pending_folder_parent == "" ? "Nova pasta na raiz:" : "Subpasta em: " + root.pending_folder_parent;
                    color: Theme.text_muted;
                    font-size: 10px;
                    overflow: elide;
                }

                HorizontalLayout {
                    spacing: 4px;

                    Rectangle {
                        horizontal-stretch: 1;
                        height: 24px;
                        border-radius: 4px;
                        background: Theme.background;
                        border-width: 1px;
                        border-color: Theme.border;

                        folder_name_input := TextInput {
                            x: 6px;
                            width: parent.width - 12px;
                            height: parent.height;
                            text <=> root.pending_folder_name;
                            color: Theme.text_primary;
                            font-size: 11px;
                            vertical-alignment: center;
                            single-line: true;
                            accepted => { root.submit_folder_creator(); }
                            key-pressed(event) => {
                                if (event.text == Key.Escape) {
                                    root.is_creating_folder = false;
                                    accept
                                } else {
                                    reject
                                }
                            }
                        }
                    }

                    Rectangle {
                        width: 22px;
                        height: 24px;
                        border-radius: 4px;
                        background: confirm_folder_touch.has-hover ? Theme.accent : Theme.surface_hover;
                        Text {
                            text: "✓";
                            color: Theme.text_primary;
                            font-size: 11px;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                        }
                        confirm_folder_touch := TouchArea {
                            mouse-cursor: pointer;
                            clicked => { root.submit_folder_creator(); }
                        }
                    }

                    Rectangle {
                        width: 22px;
                        height: 24px;
                        border-radius: 4px;
                        background: cancel_folder_touch.has-hover ? Theme.danger : Theme.surface_hover;
                        Text {
                            text: "✕";
                            color: Theme.text_primary;
                            font-size: 10px;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                        }
                        cancel_folder_touch := TouchArea {
                            mouse-cursor: pointer;
                            clicked => { root.is_creating_folder = false; }
                        }
                    }
                }
            }
        }

        // Indicador de destino raiz durante arraste
        if (root.drag_active): Rectangle {
            height: 24px;
            border-radius: 4px;
            border-width: 1px;
            border-color: root.drop_target_folder == "" ? Theme.accent : Theme.border;
            background: root.drop_target_folder == "" ? Theme.surface_active : Theme.surface;

            Text {
                text: root.drop_target_folder == ""
                    ? "📥 Soltar \"" + root.drag_source_name + "\" na Raiz"
                    : "📂 Mover \"" + root.drag_source_name + "\" → " + root.drop_target_folder;
                color: Theme.accent;
                font-size: 10px;
                font-weight: 600;
                horizontal-alignment: center;
                vertical-alignment: center;
                overflow: elide;
            }
        }

        // Lista de Arquivos e Pastas
        list_flick := Flickable {
            vertical-stretch: 1;

            // Clique com botão direito no fundo vazio da barra lateral
            TouchArea {
                pointer-event(event) => {
                    if (event.button == PointerEventButton.right && event.kind == PointerEventKind.down) {
                        root.sidebar_bg_context_menu(self.absolute-position.x + self.mouse-x, self.absolute-position.y + self.mouse-y);
                    }
                }
            }

            VerticalLayout {
                spacing: 2px;
                alignment: start;

                for item[idx] in root.items: Rectangle {
                    height: 26px;
                    border-radius: 4px;
                    border-width: (root.drag_active && item.is_folder && root.drop_target_folder == item.path) ? 1px : 0px;
                    border-color: Theme.accent;
                    background: (root.drag_active && item.is_folder && root.drop_target_folder == item.path)
                        ? Theme.surface_active
                        : (item.is_active ? Theme.surface_active : (touch_item.has-hover ? Theme.surface_hover : transparent));
                    opacity: (root.drag_active && root.drag_source_path == item.path) ? 0.45 : 1.0;

                    touch_item := TouchArea {
                        mouse-cursor: root.drag_active ? grabbing : pointer;
                        pointer-event(event) => {
                            if (event.button == PointerEventButton.right && event.kind == PointerEventKind.down) {
                                root.drag_active = false;
                                root.drag_source_path = "";
                                root.item_context_menu(
                                    item.path,
                                    item.is_folder,
                                    self.absolute-position.x + self.mouse-x,
                                    self.absolute-position.y + self.mouse-y,
                                );
                            } else if (event.button == PointerEventButton.left && event.kind == PointerEventKind.down) {
                                root.drag_source_path = item.path;
                                root.drag_source_name = item.name;
                                root.drag_start_y = self.absolute-position.y + self.mouse-y;
                                root.drag_current_y = root.drag_start_y;
                                root.drag_active = false;
                                root.suppress_next_click = false;
                                root.drop_target_folder = "";
                            } else if (event.button == PointerEventButton.left && event.kind == PointerEventKind.up) {
                                if (root.drag_active) {
                                    if (root.drag_source_path != "" && root.drag_source_path != root.drop_target_folder) {
                                        root.item_moved(root.drag_source_path, root.drop_target_folder);
                                    }
                                    root.drag_active = false;
                                    root.drag_source_path = "";
                                    root.drop_target_folder = "";
                                }
                            }
                        }
                        moved => {
                            if (self.pressed && root.drag_source_path == item.path) {
                                root.drag_current_y = self.absolute-position.y + self.mouse-y;
                                if (!root.drag_active && abs(root.drag_current_y - root.drag_start_y) > 6px) {
                                    root.drag_active = true;
                                    root.suppress_next_click = true;
                                }
                                if (root.drag_active) {
                                    if (root.drag_current_y >= list_flick.absolute-position.y
                                        && root.drag_current_y <= list_flick.absolute-position.y + list_flick.height) {
                                        let target_idx = Math.floor((root.drag_current_y - list_flick.absolute-position.y - list_flick.content-y) / 28px);
                                        if (target_idx >= 0 && target_idx < root.items.length && root.items[target_idx].is_folder) {
                                            root.drop_target_folder = root.items[target_idx].path;
                                        } else {
                                            root.drop_target_folder = "";
                                        }
                                    } else {
                                        root.drop_target_folder = "";
                                    }
                                }
                            }
                        }
                        clicked => {
                            if (root.suppress_next_click) {
                                root.suppress_next_click = false;
                            } else if (item.is_folder) {
                                root.folder_toggled(item.path);
                            } else {
                                root.note_clicked(item.path);
                            }
                        }
                    }

                    HorizontalLayout {
                        padding-left: item.indent_level * 14px + 6px;
                        padding-right: 6px;
                        spacing: 6px;
                        alignment: space-between;

                        HorizontalLayout {
                            spacing: 6px;
                            alignment: start;
                            horizontal-stretch: 1;

                            // Ícone Pasta ou Nota (com suporte a sticker/emoji)
                            Text {
                                text: item.is_folder ? (item.is_expanded ? "📂" : "📁") : (item.icon != "" ? item.icon : "📄");
                                font-size: 11px;
                                vertical-alignment: center;
                            }

                            // Nome do Arquivo / Pasta
                            Text {
                                text: item.name;
                                color: item.is_active ? Theme.accent : Theme.text_primary;
                                font-size: 12px;
                                vertical-alignment: center;
                                overflow: elide;
                            }
                        }

                        // Botão rápido "+" para criar subpasta dentro desta pasta
                        if (item.is_folder): Rectangle {
                            width: 20px;
                            height: 20px;
                            border-radius: 4px;
                            opacity: (touch_item.has-hover || touch_subfolder.has-hover) ? 1.0 : 0.0;
                            background: touch_subfolder.has-hover ? Theme.surface_active : transparent;

                            Text {
                                text: "+";
                                color: Theme.accent;
                                font-size: 12px;
                                font-weight: 700;
                                horizontal-alignment: center;
                                vertical-alignment: center;
                            }

                            touch_subfolder := TouchArea {
                                mouse-cursor: pointer;
                                clicked => { root.open_folder_creator(item.path); }
                            }
                        }
                    }
                }
            }
        }

        // Rodapé da Barra Lateral: Botão de Configurações (Estilo Obsidian)
        Rectangle {
            height: 1px;
            background: Theme.border;
        }

        Rectangle {
            height: 32px;
            border-radius: 6px;
            background: touch_settings.has-hover ? Theme.surface_hover : transparent;

            touch_settings := TouchArea {
                mouse-cursor: pointer;
                clicked => { root.settings_clicked(); }
            }

            HorizontalLayout {
                padding-left: 8px;
                padding-right: 8px;
                spacing: 8px;
                alignment: start;

                Text {
                    text: "⚙️";
                    font-size: 14px;
                    vertical-alignment: center;
                }
                Text {
                    text: "Configurações";
                    color: touch_settings.has-hover ? Theme.text_primary : Theme.text_secondary;
                    font-size: 12px;
                    font-weight: 500;
                    vertical-alignment: center;
                }
            }
        }
    }
}
