export global Theme {
    in property <color> background: #1e1e2e;
    in property <color> sidebar_bg: #181825;
    in property <color> surface: #313244;
    in property <color> surface_hover: #45475a;
    in property <color> surface_active: #585b70;
    in property <color> text_primary: #cdd6f4;
    in property <color> text_secondary: #a6adc8;
    in property <color> text_muted: #6c7086;
    in property <color> accent: #89b4fa;
    in property <color> border: #313244;
    in property <color> success: #a6e3a1;
    in property <color> warning: #f9e2af;
    in property <color> danger: #f38ba8;
}
