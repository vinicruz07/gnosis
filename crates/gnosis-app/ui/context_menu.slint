import { Theme } from "theme.slint";

export struct ContextMenuItem {
    id: string,
    label: string,
    icon: string,
    is_danger: bool,
    is_separator: bool,
}

export component ContextMenu inherits Rectangle {
    in property <bool> is_open: false;
    in property <length> anchor_x: 0px;
    in property <length> anchor_y: 0px;
    in property <[ContextMenuItem]> items: [];

    callback item_selected(string);
    callback close_requested();

    visible: root.is_open;
    width: 100%;
    height: 100%;

    // Backdrop transparente para fechar ao clicar fora
    TouchArea {
        pointer-event(event) => {
            if (event.kind == PointerEventKind.down) {
                root.close_requested();
            }
        }
    }

    menu_box := Rectangle {
        width: 236px;
        height: root.items.length * 28px + 12px;
        x: max(8px, min(root.anchor_x, root.width - self.width - 8px));
        y: max(8px, min(root.anchor_y, root.height - self.height - 8px));
        background: Theme.surface;
        border-radius: 8px;
        border-width: 1px;
        border-color: Theme.border;
        drop-shadow-blur: 12px;
        drop-shadow-color: #00000080;

        // Absorve cliques dentro do menu
        TouchArea {}

        VerticalLayout {
            padding: 6px;
            spacing: 0px;

            for item in root.items: Rectangle {
                height: item.is_separator ? 9px : 28px;
                border-radius: 5px;
                background: (!item.is_separator && item_touch.has-hover)
                    ? (item.is_danger ? #ef444425 : Theme.surface_hover)
                    : transparent;

                if (item.is_separator): Rectangle {
                    y: 4px;
                    height: 1px;
                    width: 100%;
                    background: Theme.border;
                }

                item_touch := TouchArea {
                    mouse-cursor: item.is_separator ? default : pointer;
                    clicked => {
                        if (!item.is_separator) {
                            root.item_selected(item.id);
                        }
                    }
                }

                if (!item.is_separator): HorizontalLayout {
                    padding-left: 8px;
                    padding-right: 8px;
                    spacing: 8px;
                    alignment: start;

                    Text {
                        text: item.icon;
                        font-size: 12px;
                        width: 18px;
                        vertical-alignment: center;
                        horizontal-alignment: center;
                    }

                    Text {
                        text: item.label;
                        color: item.is_danger ? Theme.danger : Theme.text_primary;
                        font-size: 12px;
                        vertical-alignment: center;
                        overflow: elide;
                    }
                }
            }
        }
    }
}

export component ConfirmDeleteModal inherits Rectangle {
    in property <bool> is_open: false;
    in property <string> item_title: "";
    in property <string> item_kind_label: "item";
    in-out property <bool> dont_ask_again: false;

    callback confirmed();
    callback cancelled();

    visible: root.is_open;
    width: 100%;
    height: 100%;
    background: #000000aa;

    TouchArea {
        clicked => { root.cancelled(); }
    }

    Rectangle {
        width: 400px;
        height: 210px;
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
        background: Theme.surface;
        border-radius: 10px;
        border-width: 1px;
        border-color: Theme.border;

        TouchArea {}

        VerticalLayout {
            padding: 20px;
            spacing: 14px;
            alignment: space-between;

            VerticalLayout {
                spacing: 8px;

                Text {
                    text: "🗑️ Confirmar exclusão";
                    color: Theme.text_primary;
                    font-size: 15px;
                    font-weight: 700;
                }

                Text {
                    text: "Tem certeza que deseja excluir " + root.item_kind_label + " \"" + root.item_title + "\"? Esta ação remove do disco e não pode ser desfeita.";
                    color: Theme.text_secondary;
                    font-size: 12px;
                    wrap: word-wrap;
                }
            }

            // Checkbox "Não perguntar novamente"
            Rectangle {
                height: 28px;
                border-radius: 6px;
                background: chk_touch.has-hover ? Theme.surface_hover : transparent;

                chk_touch := TouchArea {
                    mouse-cursor: pointer;
                    clicked => { root.dont_ask_again = !root.dont_ask_again; }
                }

                HorizontalLayout {
                    padding-left: 4px;
                    spacing: 8px;
                    alignment: start;

                    Rectangle {
                        width: 16px;
                        height: 16px;
                        y: 6px;
                        border-radius: 4px;
                        border-width: 1.5px;
                        border-color: root.dont_ask_again ? Theme.accent : Theme.text_muted;
                        background: root.dont_ask_again ? Theme.accent : transparent;

                        Text {
                            text: root.dont_ask_again ? "✓" : "";
                            color: #ffffff;
                            font-size: 10px;
                            font-weight: 700;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                        }
                    }

                    Text {
                        text: "Não perguntar novamente";
                        color: Theme.text_secondary;
                        font-size: 12px;
                        vertical-alignment: center;
                    }
                }
            }

            HorizontalLayout {
                alignment: end;
                spacing: 10px;

                Rectangle {
                    width: 96px;
                    height: 32px;
                    border-radius: 6px;
                    border-width: 1px;
                    border-color: Theme.border;
                    background: cancel_btn.has-hover ? Theme.surface_hover : Theme.background;

                    cancel_btn := TouchArea {
                        mouse-cursor: pointer;
                        clicked => { root.cancelled(); }
                    }

                    Text {
                        text: "Cancelar";
                        color: Theme.text_primary;
                        font-size: 12px;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }
                }

                Rectangle {
                    width: 96px;
                    height: 32px;
                    border-radius: 6px;
                    background: confirm_btn.has-hover ? #dc2626 : Theme.danger;

                    confirm_btn := TouchArea {
                        mouse-cursor: pointer;
                        clicked => { root.confirmed(); }
                    }

                    Text {
                        text: "Excluir";
                        color: #ffffff;
                        font-size: 12px;
                        font-weight: 600;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }
                }
            }
        }
    }
}
