import { Theme } from "theme.slint";

export component StatusBar inherits Rectangle {
    in property <string> vault_name: "Meu Vault";
    in property <string> sync_status: "Sincronizado (Local)";
    in property <color> sync_color: Theme.success;
    in property <int> word_count: 0;
    in property <int> char_count: 0;

    callback theme_clicked();
    callback sync_clicked();

    height: 28px;
    background: Theme.sidebar_bg;
    border-top-width: 1px;
    border-color: Theme.border;

    HorizontalLayout {
        padding-left: 12px;
        padding-right: 12px;
        alignment: space-between;

        // Esquerda: Identificador do Vault
        HorizontalLayout {
            spacing: 6px;
            alignment: start;

            Text {
                text: "📁";
                font-size: 11px;
                vertical-alignment: center;
            }

            Text {
                text: root.vault_name;
                color: Theme.text_secondary;
                font-size: 11px;
                vertical-alignment: center;
            }
        }

        // Centro: Status da Sincronização P2P / BYOS (Clicável para abrir modal)
        Rectangle {
            height: 22px;
            border-radius: 4px;
            background: touch_sync.has-hover ? Theme.surface_hover : transparent;
            padding-left: 8px;
            padding-right: 8px;
            y: (parent.height - self.height) / 2;

            HorizontalLayout {
                spacing: 6px;
                alignment: center;

                Rectangle {
                    width: 8px;
                    height: 8px;
                    border-radius: 4px;
                    background: root.sync_color;
                    y: (parent.height - self.height) / 2;
                }

                Text {
                    text: root.sync_status;
                    color: Theme.text_muted;
                    font-size: 11px;
                    vertical-alignment: center;
                }
            }

            touch_sync := TouchArea {
                clicked => { root.sync_clicked(); }
            }
        }

        // Direita: Seletor de Tema Místico e Métricas
        HorizontalLayout {
            spacing: 12px;
            alignment: end;

            // Botão Seletor de Tema Místico (Ctrl+Shift+T)
            Rectangle {
                padding-left: 6px;
                padding-right: 6px;
                height: 20px;
                border-radius: 4px;
                background: touch_theme.has-hover ? Theme.surface_hover : transparent;
                y: (parent.height - self.height) / 2;

                HorizontalLayout {
                    spacing: 4px;
                    alignment: center;

                    Text {
                        text: "✨ " + Theme.active_theme_name;
                        color: Theme.accent;
                        font-size: 11px;
                        font-weight: 600;
                        vertical-alignment: center;
                    }
                }

                touch_theme := TouchArea {
                    clicked => { root.theme_clicked(); }
                }
            }

            // Contador de palavras e caracteres
            Text {
                text: root.word_count + " palavras  |  " + root.char_count + " caracteres";
                color: Theme.text_muted;
                font-size: 11px;
                vertical-alignment: center;
            }
        }
    }
}
