import { Theme } from "theme.slint";

export component DocumentEditor inherits Rectangle {
    in property <image> surface_image;

    callback viewport_resized(float, float);
    callback pointer_down(float, float, bool);
    callback pointer_moved(float, float);
    callback scrolled(float);
    callback key_pressed_event(string, bool, bool, bool);
    callback context_menu_requested(length, length);

    background: Theme.background;
    clip: true;

    changed width => {
        root.viewport_resized(self.width / 1px, self.height / 1px);
    }
    changed height => {
        root.viewport_resized(self.width / 1px, self.height / 1px);
    }

    focus_scope := FocusScope {
        width: 100%;
        height: 100%;

        key-pressed(event) => {
            root.key_pressed_event(
                event.text,
                event.modifiers.control,
                event.modifiers.shift,
                event.modifiers.alt,
            );
            accept
        }

        touch := TouchArea {
            width: 100%;
            height: 100%;
            mouse-cursor: text;

            pointer-event(event) => {
                if (event.button == PointerEventButton.right && event.kind == PointerEventKind.down) {
                    root.context_menu_requested(
                        self.absolute-position.x + self.mouse-x,
                        self.absolute-position.y + self.mouse-y,
                    );
                } else if (event.button == PointerEventButton.left && event.kind == PointerEventKind.down) {
                    focus_scope.focus();
                    root.pointer_down(
                        self.mouse-x / 1px,
                        self.mouse-y / 1px,
                        event.modifiers.shift,
                    );
                }
            }

            moved => {
                if (self.pressed) {
                    root.pointer_moved(self.mouse-x / 1px, self.mouse-y / 1px);
                }
            }

            scroll-event(event) => {
                root.scrolled(event.delta-y / 1px);
                accept
            }
        }

        Image {
            width: 100%;
            height: 100%;
            source: root.surface_image;
            image-fit: fill;
        }
    }
}
