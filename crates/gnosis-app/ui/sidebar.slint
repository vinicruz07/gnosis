import { Theme } from "theme.slint";

export struct TreeItemData {
    id: string,
    name: string,
    path: string,
    is_folder: bool,
    is_expanded: bool,
    indent_level: int,
    is_active: bool,
    icon: string,
}

export component Sidebar inherits Rectangle {
    in property <string> vault_title: "Meu Vault";
    in property <[TreeItemData]> items: [];
    in property <bool> is_collapsed: false;

    callback note_clicked(string);
    callback folder_toggled(string);
    callback toggle_sidebar();
    callback new_note_requested();
    callback settings_clicked();
    callback grimoire_clicked();

    background: Theme.sidebar_bg;
    width: root.is_collapsed ? 0px : 240px;
    animate width { duration: 150ms; easing: ease-out; }

    // Divisória vertical direita
    Rectangle {
        x: parent.width - 1px;
        width: 1px;
        height: 100%;
        background: Theme.border;
    }

    VerticalLayout {
        padding: 8px;
        spacing: 6px;

        // Cabeçalho da Barra Lateral (Identidade do Grimório + Ações Rápidas)
        HorizontalLayout {
            height: 28px;
            alignment: space-between;

            // Seletor Interativo do Grimório Ativo
            Rectangle {
                border-radius: 4px;
                background: touch_grimoire_title.has-hover ? Theme.surface_hover : transparent;

                touch_grimoire_title := TouchArea {
                    mouse-cursor: pointer;
                    clicked => { root.grimoire_clicked(); }
                }

                HorizontalLayout {
                    padding-left: 4px;
                    padding-right: 6px;
                    spacing: 4px;
                    alignment: start;

                    Text {
                        text: "📖";
                        font-size: 13px;
                        vertical-alignment: center;
                    }

                    Text {
                        text: root.vault_title;
                        color: touch_grimoire_title.has-hover ? Theme.accent : Theme.text_primary;
                        font-size: 13px;
                        font-weight: 600;
                        vertical-alignment: center;
                        overflow: elide;
                    }

                    Text {
                        text: "▾";
                        color: Theme.text_muted;
                        font-size: 10px;
                        vertical-alignment: center;
                    }
                }
            }

            HorizontalLayout {
                spacing: 4px;
                alignment: end;

                // Botão Nova Nota (ao lado do nome do Grimório)
                Rectangle {
                    width: 24px;
                    height: 24px;
                    border-radius: 4px;
                    background: touch_new.has-hover ? Theme.surface_hover : transparent;

                    Text {
                        text: "➕";
                        font-size: 11px;
                        vertical-alignment: center;
                        horizontal-alignment: center;
                    }

                    touch_new := TouchArea {
                        mouse-cursor: pointer;
                        clicked => { root.new_note_requested(); }
                    }
                }

                // Botão Recolher Barra Lateral
                Rectangle {
                    width: 24px;
                    height: 24px;
                    border-radius: 4px;
                    background: touch_collapse.has-hover ? Theme.surface_hover : transparent;

                    Text {
                        text: "◀";
                        color: Theme.text_muted;
                        font-size: 10px;
                        vertical-alignment: center;
                        horizontal-alignment: center;
                    }

                    touch_collapse := TouchArea {
                        mouse-cursor: pointer;
                        clicked => { root.toggle_sidebar(); }
                    }
                }
            }
        }

        // Divisor sutil
        Rectangle {
            height: 1px;
            background: Theme.border;
        }

        // Lista de Arquivos e Pastas
        Flickable {
            vertical-stretch: 1;

            VerticalLayout {
                spacing: 2px;
                alignment: start;

                for item in root.items: Rectangle {
                    height: 26px;
                    border-radius: 4px;
                    background: item.is_active ? Theme.surface_active : (touch_item.has-hover ? Theme.surface_hover : transparent);

                    HorizontalLayout {
                        padding-left: item.indent_level * 14px + 6px;
                        padding-right: 6px;
                        spacing: 6px;
                        alignment: start;

                        // Ícone Pasta ou Nota (com suporte a sticker/emoji)
                        Text {
                            text: item.is_folder ? (item.is_expanded ? "📂" : "📁") : (item.icon != "" ? item.icon : "📄");
                            font-size: 11px;
                            vertical-alignment: center;
                        }


                        // Nome do Arquivo / Pasta
                        Text {
                            text: item.name;
                            color: item.is_active ? Theme.accent : Theme.text_primary;
                            font-size: 12px;
                            vertical-alignment: center;
                            overflow: elide;
                        }
                    }

                    touch_item := TouchArea {
                        clicked => {
                            if (item.is_folder) {
                                root.folder_toggled(item.path);
                            } else {
                                root.note_clicked(item.path);
                            }
                        }
                    }
                }
            }
        }

        // Rodapé da Barra Lateral: Botão de Configurações (Estilo Obsidian)
        Rectangle {
            height: 1px;
            background: Theme.border;
        }

        Rectangle {
            height: 32px;
            border-radius: 6px;
            background: touch_settings.has-hover ? Theme.surface_hover : transparent;

            touch_settings := TouchArea {
                mouse-cursor: pointer;
                clicked => { root.settings_clicked(); }
            }

            HorizontalLayout {
                padding-left: 8px;
                padding-right: 8px;
                spacing: 8px;
                alignment: start;

                Text {
                    text: "⚙️";
                    font-size: 14px;
                    vertical-alignment: center;
                }
                Text {
                    text: "Configurações";
                    color: touch_settings.has-hover ? Theme.text_primary : Theme.text_secondary;
                    font-size: 12px;
                    font-weight: 500;
                    vertical-alignment: center;
                }
            }
        }
    }
}
