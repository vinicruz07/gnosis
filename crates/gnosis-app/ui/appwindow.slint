import { Theme } from "theme.slint";
import { Sidebar, TreeItemData } from "sidebar.slint";
import { StatusBar } from "statusbar.slint";
import { TabBar, TabData } from "tabbar.slint";

export component AppWindow inherits Window {
    title: "Gnosis";
    preferred-width: 1024px;
    preferred-height: 700px;
    min-width: 640px;
    min-height: 400px;
    background: Theme.background;

    // Propriedades do Vault e Arquivos
    in property <string> vault_name: "Meu Vault";
    in property <[TreeItemData]> file_tree: [];
    in-out property <bool> sidebar_collapsed: false;

    // Propriedades do Painel Primário
    in property <string> active_note_title: "Boas-vindas ao Gnosis";
    in property <string> active_note_content: "# Bem-vindo ao Gnosis\n\nRecompilação de alto desempenho do Obsidian em Rust puro.";

    // Propriedades do Painel Secundário (Split View)
    in property <bool> is_split: false;
    in property <string> secondary_note_title: "Nota Dividida";
    in property <string> secondary_note_content: "Este painel está em modo Split View lado a lado.";

    // Propriedades de Abas e Histórico
    in property <[TabData]> tabs: [];
    in property <bool> can_go_back: false;
    in property <bool> can_go_forward: false;

    // Propriedades da Barra de Status
    in property <string> sync_status: "Sincronizado (Local)";
    in property <color> sync_color: Theme.success;
    in property <int> word_count: 14;
    in property <int> char_count: 85;

    // Callbacks para eventos do usuário
    callback note_selected(string);
    callback folder_toggled(string);
    callback toggle_sidebar();
    callback new_note_requested();
    callback content_changed(string);

    // Callbacks de Abas, Split e Histórico
    callback tab_selected(int);
    callback tab_closed(int);
    callback go_back();
    callback go_forward();
    callback toggle_split();
    callback new_tab();

    VerticalLayout {
        spacing: 0px;

        // Área Central (Barra Lateral + Abas + Editor / Split)
        HorizontalLayout {
            vertical-stretch: 1;
            spacing: 0px;

            // Barra Lateral de Arquivos
            Sidebar {
                vault_title: root.vault_name;
                items: root.file_tree;
                is_collapsed: root.sidebar_collapsed;

                note_clicked(path) => { root.note_selected(path); }
                folder_toggled(path) => { root.folder_toggled(path); }
                toggle_sidebar => { root.toggle_sidebar(); }
                new_note_requested => { root.new_note_requested(); }
            }

            // Botão de reabertura da barra lateral quando recolhida
            if (root.sidebar_collapsed): Rectangle {
                width: 28px;
                background: Theme.sidebar_bg;
                border-right-width: 1px;
                border-color: Theme.border;

                Text {
                    text: "▶";
                    color: Theme.text_muted;
                    font-size: 11px;
                    vertical-alignment: center;
                    horizontal-alignment: center;
                }

                TouchArea {
                    clicked => { root.toggle_sidebar(); }
                }
            }

            // Área Central de Trabalho (Abas no topo + Painel ou Split View)
            VerticalLayout {
                horizontal-stretch: 1;
                spacing: 0px;

                // Barra de Abas Superiores
                TabBar {
                    tabs: root.tabs;
                    can_go_back: root.can_go_back;
                    can_go_forward: root.can_go_forward;
                    is_split: root.is_split;

                    tab_selected(idx) => { root.tab_selected(idx); }
                    tab_closed(idx) => { root.tab_closed(idx); }
                    go_back => { root.go_back(); }
                    go_forward => { root.go_forward(); }
                    toggle_split => { root.toggle_split(); }
                    new_tab => { root.new_tab(); }
                }

                // Corpo dos Editores (Único ou Lado a Lado se Split)
                HorizontalLayout {
                    vertical-stretch: 1;
                    spacing: 0px;

                    // Painel Principal
                    Rectangle {
                        horizontal-stretch: 1;
                        background: Theme.background;

                        VerticalLayout {
                            padding: 16px;
                            spacing: 12px;

                            HorizontalLayout {
                                height: 32px;
                                alignment: space-between;

                                Text {
                                    text: root.active_note_title;
                                    color: Theme.text_primary;
                                    font-size: 18px;
                                    font-weight: 700;
                                    vertical-alignment: center;
                                }
                            }

                            Rectangle {
                                height: 1px;
                                background: Theme.border;
                            }

                            Flickable {
                                vertical-stretch: 1;

                                Text {
                                    text: root.active_note_content;
                                    color: Theme.text_secondary;
                                    font-size: 14px;
                                    wrap: word-wrap;
                                }
                            }
                        }
                    }

                    // Painel Secundário se Split View Ativo
                    if (root.is_split): HorizontalLayout {
                        horizontal-stretch: 1;
                        spacing: 0px;

                        // Divisor Central
                        Rectangle {
                            width: 1px;
                            background: Theme.border;
                        }

                        Rectangle {
                            horizontal-stretch: 1;
                            background: Theme.background;

                            VerticalLayout {
                                padding: 16px;
                                spacing: 12px;

                                HorizontalLayout {
                                    height: 32px;
                                    alignment: space-between;

                                    Text {
                                        text: root.secondary_note_title;
                                        color: Theme.text_primary;
                                        font-size: 18px;
                                        font-weight: 700;
                                        vertical-alignment: center;
                                    }
                                }

                                Rectangle {
                                    height: 1px;
                                    background: Theme.border;
                                }

                                Flickable {
                                    vertical-stretch: 1;

                                    Text {
                                        text: root.secondary_note_content;
                                        color: Theme.text_secondary;
                                        font-size: 14px;
                                        wrap: word-wrap;
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }

        // Barra de Status Inferior
        StatusBar {
            vault_name: root.vault_name;
            sync_status: root.sync_status;
            sync_color: root.sync_color;
            word_count: root.word_count;
            char_count: root.char_count;
        }
    }
}
