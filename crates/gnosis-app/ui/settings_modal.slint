import { Theme } from "theme.slint";

export component SettingsModal inherits Rectangle {
    in property <bool> is_open: false;
    in-out property <int> active_tab_index: 0;
    
    // Preferências de configuração
    in-out property <int> font_size: 15;
    in-out property <bool> line_wrapping: true;
    in-out property <int> tab_size: 4;
    in-out property <bool> default_live_preview: true;
    in-out property <bool> compact_mode: false;
    in property <string> theme_name: "Abyss";
    in property <string> engine_info: "FemtoVG / Software Renderer (Hardware 2015- 60FPS)";
    in property <string> app_version: "0.1.0";

    // Callbacks de interação
    callback close_modal();
    callback tab_selected(int);
    callback font_size_changed(int);
    callback tab_size_changed(int);
    callback line_wrapping_toggled();
    callback default_live_preview_toggled();
    callback compact_mode_toggled();

    background: #000000bb;
    width: 100%;
    height: 100%;
    visible: root.is_open;

    // Clique fora da janela fecha o modal
    TouchArea {
        clicked => { root.close_modal(); }
    }

    // Janela flutuante centralizada
    Rectangle {
        width: 740px;
        height: 520px;
        background: Theme.surface;
        border-radius: 12px;
        border-width: 1px;
        border-color: Theme.border;
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
        clip: true;

        // Previne fechamento ao clicar dentro da janela
        TouchArea {}

        HorizontalLayout {
            // Coluna Esquerda: Menu Lateral de Abas
            Rectangle {
                width: 220px;
                background: Theme.sidebar_bg;
                border-width: 0px;

                // Linha divisória vertical à direita
                Rectangle {
                    x: parent.width - 1px;
                    y: 0px;
                    width: 1px;
                    height: parent.height;
                    background: Theme.border;
                }

                VerticalLayout {
                    padding: 16px;
                    spacing: 8px;

                    // Cabeçalho da Sidebar de Configurações
                    HorizontalLayout {
                        spacing: 8px;
                        padding-bottom: 12px;

                        Text {
                            text: "⚙️";
                            font-size: 18px;
                            vertical-alignment: center;
                        }
                        Text {
                            text: "Configurações";
                            color: Theme.text_primary;
                            font-size: 15px;
                            font-weight: 700;
                            vertical-alignment: center;
                        }
                    }

                    // Botão Aba: Geral (0)
                    Rectangle {
                        height: 38px;
                        border-radius: 6px;
                        background: root.active_tab_index == 0 ? Theme.surface_active : tab0_area.has-hover ? Theme.surface_hover : transparent;

                        tab0_area := TouchArea {
                            mouse-cursor: pointer;
                            clicked => { root.tab_selected(0); }
                        }

                        HorizontalLayout {
                            padding-left: 12px;
                            padding-right: 12px;
                            spacing: 10px;
                            alignment: start;

                            Text {
                                text: "⚙️";
                                font-size: 14px;
                                vertical-alignment: center;
                            }
                            Text {
                                text: "Geral";
                                color: root.active_tab_index == 0 ? Theme.accent : Theme.text_secondary;
                                font-size: 13px;
                                font-weight: root.active_tab_index == 0 ? 600 : 400;
                                vertical-alignment: center;
                            }
                        }
                    }

                    // Botão Aba: Aparência (1)
                    Rectangle {
                        height: 38px;
                        border-radius: 6px;
                        background: root.active_tab_index == 1 ? Theme.surface_active : tab1_area.has-hover ? Theme.surface_hover : transparent;

                        tab1_area := TouchArea {
                            mouse-cursor: pointer;
                            clicked => { root.tab_selected(1); }
                        }

                        HorizontalLayout {
                            padding-left: 12px;
                            padding-right: 12px;
                            spacing: 10px;
                            alignment: start;

                            Text {
                                text: "🎨";
                                font-size: 14px;
                                vertical-alignment: center;
                            }
                            Text {
                                text: "Aparência";
                                color: root.active_tab_index == 1 ? Theme.accent : Theme.text_secondary;
                                font-size: 13px;
                                font-weight: root.active_tab_index == 1 ? 600 : 400;
                                vertical-alignment: center;
                            }
                        }
                    }

                    // Botão Aba: Editor (2)
                    Rectangle {
                        height: 38px;
                        border-radius: 6px;
                        background: root.active_tab_index == 2 ? Theme.surface_active : tab2_area.has-hover ? Theme.surface_hover : transparent;

                        tab2_area := TouchArea {
                            mouse-cursor: pointer;
                            clicked => { root.tab_selected(2); }
                        }

                        HorizontalLayout {
                            padding-left: 12px;
                            padding-right: 12px;
                            spacing: 10px;
                            alignment: start;

                            Text {
                                text: "✏️";
                                font-size: 14px;
                                vertical-alignment: center;
                            }
                            Text {
                                text: "Editor";
                                color: root.active_tab_index == 2 ? Theme.accent : Theme.text_secondary;
                                font-size: 13px;
                                font-weight: root.active_tab_index == 2 ? 600 : 400;
                                vertical-alignment: center;
                            }
                        }
                    }

                    // Botão Aba: Sobre (3)
                    Rectangle {
                        height: 38px;
                        border-radius: 6px;
                        background: root.active_tab_index == 3 ? Theme.surface_active : tab3_area.has-hover ? Theme.surface_hover : transparent;

                        tab3_area := TouchArea {
                            mouse-cursor: pointer;
                            clicked => { root.tab_selected(3); }
                        }

                        HorizontalLayout {
                            padding-left: 12px;
                            padding-right: 12px;
                            spacing: 10px;
                            alignment: start;

                            Text {
                                text: "ℹ️";
                                font-size: 14px;
                                vertical-alignment: center;
                            }
                            Text {
                                text: "Sobre";
                                color: root.active_tab_index == 3 ? Theme.accent : Theme.text_secondary;
                                font-size: 13px;
                                font-weight: root.active_tab_index == 3 ? 600 : 400;
                                vertical-alignment: center;
                            }
                        }
                    }

                    // Espaçador vertical para empurrar rodapé
                    Rectangle {}

                    // Rodapé da Sidebar
                    Text {
                        text: "Gnosis v" + root.app_version;
                        color: Theme.text_muted;
                        font-size: 11px;
                        horizontal-alignment: center;
                    }
                }
            }

            // Coluna Direita: Painel de Conteúdo da Aba Ativa
            Rectangle {
                horizontal-stretch: 1;
                background: Theme.surface;

                VerticalLayout {
                    padding: 24px;
                    spacing: 20px;

                    // Topo com Título da Seção e Botão Fechar
                    HorizontalLayout {
                        alignment: space-between;

                        VerticalLayout {
                            spacing: 4px;
                            Text {
                                text: root.active_tab_index == 0 ? "Configurações Gerais" :
                                      root.active_tab_index == 1 ? "Aparência & Temas" :
                                      root.active_tab_index == 2 ? "Preferências do Editor" : "Sobre o Gnosis";
                                color: Theme.text_primary;
                                font-size: 18px;
                                font-weight: 700;
                            }
                            Text {
                                text: root.active_tab_index == 0 ? "Ajustes básicos da aplicação e cofre local." :
                                      root.active_tab_index == 1 ? "Personalização de cores e densidade visual." :
                                      root.active_tab_index == 2 ? "Comportamento de digitação, Live Preview e fontes." :
                                      "Arquitetura, telemetria gráfica e integridade do sistema.";
                                color: Theme.text_muted;
                                font-size: 12px;
                            }
                        }

                        // Botão Fechar ✕
                        Rectangle {
                            width: 32px;
                            height: 32px;
                            border-radius: 6px;
                            background: close_area.has-hover ? Theme.surface_hover : transparent;

                            close_area := TouchArea {
                                mouse-cursor: pointer;
                                clicked => { root.close_modal(); }
                            }

                            Text {
                                text: "✕";
                                color: close_area.has-hover ? Theme.danger : Theme.text_secondary;
                                font-size: 14px;
                                horizontal-alignment: center;
                                vertical-alignment: center;
                            }
                        }
                    }

                    // Linha divisória horizontal
                    Rectangle {
                        height: 1px;
                        background: Theme.border;
                    }

                    // Painel: GERAL (active_tab_index == 0)
                    if root.active_tab_index == 0: VerticalLayout {
                        spacing: 16px;

                        Rectangle {
                            background: Theme.background;
                            border-radius: 8px;
                            border-width: 1px;
                            border-color: Theme.border;
                            height: 64px;

                            HorizontalLayout {
                                padding-left: 16px;
                                padding-right: 16px;
                                alignment: space-between;

                                VerticalLayout {
                                    alignment: center;
                                    spacing: 4px;
                                    Text {
                                        text: "Armazenamento do Cofre";
                                        color: Theme.text_primary;
                                        font-size: 13px;
                                        font-weight: 600;
                                    }
                                    Text {
                                        text: "Modo Local / Portable (VFS Nativo)";
                                        color: Theme.text_muted;
                                        font-size: 11px;
                                    }
                                }

                                Text {
                                    text: "💾 Ativo";
                                    color: Theme.success;
                                    font-size: 12px;
                                    font-weight: 600;
                                    vertical-alignment: center;
                                }
                            }
                        }

                        Rectangle {
                            background: Theme.background;
                            border-radius: 8px;
                            border-width: 1px;
                            border-color: Theme.border;
                            height: 64px;

                            HorizontalLayout {
                                padding-left: 16px;
                                padding-right: 16px;
                                alignment: space-between;

                                VerticalLayout {
                                    alignment: center;
                                    spacing: 4px;
                                    Text {
                                        text: "Salvamento Automático";
                                        color: Theme.text_primary;
                                        font-size: 13px;
                                        font-weight: 600;
                                    }
                                    Text {
                                        text: "Persistência contínua ao digitar com tolerância a falhas.";
                                        color: Theme.text_muted;
                                        font-size: 11px;
                                    }
                                }

                                Text {
                                    text: "1000 ms";
                                    color: Theme.text_secondary;
                                    font-size: 12px;
                                    vertical-alignment: center;
                                }
                            }
                        }

                        Rectangle {}
                    }

                    // Painel: APARÊNCIA (active_tab_index == 1)
                    if root.active_tab_index == 1: VerticalLayout {
                        spacing: 16px;

                        Rectangle {
                            background: Theme.background;
                            border-radius: 8px;
                            border-width: 1px;
                            border-color: Theme.border;
                            height: 64px;

                            HorizontalLayout {
                                padding-left: 16px;
                                padding-right: 16px;
                                alignment: space-between;

                                VerticalLayout {
                                    alignment: center;
                                    spacing: 4px;
                                    Text {
                                        text: "Tema de Cores Ativo";
                                        color: Theme.text_primary;
                                        font-size: 13px;
                                        font-weight: 600;
                                    }
                                    Text {
                                        text: "Utilize Ctrl+T para alternar temas instantaneamente.";
                                        color: Theme.text_muted;
                                        font-size: 11px;
                                    }
                                }

                                Rectangle {
                                    width: 110px;
                                    height: 32px;
                                    border-radius: 6px;
                                    background: Theme.surface_active;
                                    border-width: 1px;
                                    border-color: Theme.accent;

                                    Text {
                                        text: root.theme_name;
                                        color: Theme.text_primary;
                                        font-size: 12px;
                                        font-weight: 600;
                                        horizontal-alignment: center;
                                        vertical-alignment: center;
                                    }
                                }
                            }
                        }

                        Rectangle {
                            background: Theme.background;
                            border-radius: 8px;
                            border-width: 1px;
                            border-color: Theme.border;
                            height: 64px;

                            HorizontalLayout {
                                padding-left: 16px;
                                padding-right: 16px;
                                alignment: space-between;

                                VerticalLayout {
                                    alignment: center;
                                    spacing: 4px;
                                    Text {
                                        text: "Densidade Compacta";
                                        color: Theme.text_primary;
                                        font-size: 13px;
                                        font-weight: 600;
                                    }
                                    Text {
                                        text: "Reduz margens e espaçamentos para telas de baixa resolução.";
                                        color: Theme.text_muted;
                                        font-size: 11px;
                                    }
                                }

                                Rectangle {
                                    width: 80px;
                                    height: 32px;
                                    border-radius: 6px;
                                    background: root.compact_mode ? Theme.accent : Theme.surface_hover;

                                    TouchArea {
                                        mouse-cursor: pointer;
                                        clicked => { root.compact_mode_toggled(); }
                                    }

                                    Text {
                                        text: root.compact_mode ? "Ativo" : "Padrão";
                                        color: root.compact_mode ? #ffffff : Theme.text_secondary;
                                        font-size: 12px;
                                        horizontal-alignment: center;
                                        vertical-alignment: center;
                                    }
                                }
                            }
                        }

                        Rectangle {}
                    }

                    // Painel: EDITOR (active_tab_index == 2)
                    if root.active_tab_index == 2: VerticalLayout {
                        spacing: 16px;

                        // Opção: Modo Padrão Live Preview
                        Rectangle {
                            background: Theme.background;
                            border-radius: 8px;
                            border-width: 1px;
                            border-color: Theme.border;
                            height: 64px;

                            HorizontalLayout {
                                padding-left: 16px;
                                padding-right: 16px;
                                alignment: space-between;

                                VerticalLayout {
                                    alignment: center;
                                    spacing: 4px;
                                    Text {
                                        text: "Editor Padrão: Live Preview";
                                        color: Theme.text_primary;
                                        font-size: 13px;
                                        font-weight: 600;
                                    }
                                    Text {
                                        text: "Abrir notas diretamente no modo WYSIWYG interativo.";
                                        color: Theme.text_muted;
                                        font-size: 11px;
                                    }
                                }

                                Rectangle {
                                    width: 120px;
                                    height: 32px;
                                    border-radius: 6px;
                                    background: root.default_live_preview ? Theme.accent : Theme.surface_hover;

                                    TouchArea {
                                        mouse-cursor: pointer;
                                        clicked => { root.default_live_preview_toggled(); }
                                    }

                                    Text {
                                        text: root.default_live_preview ? "✨ Live Preview" : "📄 Fonte Bruta";
                                        color: root.default_live_preview ? #ffffff : Theme.text_secondary;
                                        font-size: 12px;
                                        horizontal-alignment: center;
                                        vertical-alignment: center;
                                    }
                                }
                            }
                        }

                        // Opção: Tamanho da Fonte
                        Rectangle {
                            background: Theme.background;
                            border-radius: 8px;
                            border-width: 1px;
                            border-color: Theme.border;
                            height: 64px;

                            HorizontalLayout {
                                padding-left: 16px;
                                padding-right: 16px;
                                alignment: space-between;

                                VerticalLayout {
                                    alignment: center;
                                    spacing: 4px;
                                    Text {
                                        text: "Tamanho da Fonte";
                                        color: Theme.text_primary;
                                        font-size: 13px;
                                        font-weight: 600;
                                    }
                                    Text {
                                        text: "Tamanho do texto no editor (10px a 32px).";
                                        color: Theme.text_muted;
                                        font-size: 11px;
                                    }
                                }

                                HorizontalLayout {
                                    spacing: 8px;
                                    alignment: center;

                                    Rectangle {
                                        width: 32px;
                                        height: 32px;
                                        border-radius: 6px;
                                        background: dec_font.has-hover ? Theme.surface_hover : Theme.surface_active;

                                        dec_font := TouchArea {
                                            mouse-cursor: pointer;
                                            clicked => {
                                                if root.font_size > 10 {
                                                    root.font_size_changed(root.font_size - 1);
                                                }
                                            }
                                        }

                                        Text {
                                            text: "-";
                                            color: Theme.text_primary;
                                            font-size: 16px;
                                            font-weight: 700;
                                            horizontal-alignment: center;
                                            vertical-alignment: center;
                                        }
                                    }

                                    Text {
                                        text: root.font_size + " px";
                                        color: Theme.accent;
                                        font-size: 13px;
                                        font-weight: 600;
                                        vertical-alignment: center;
                                    }

                                    Rectangle {
                                        width: 32px;
                                        height: 32px;
                                        border-radius: 6px;
                                        background: inc_font.has-hover ? Theme.surface_hover : Theme.surface_active;

                                        inc_font := TouchArea {
                                            mouse-cursor: pointer;
                                            clicked => {
                                                if root.font_size < 32 {
                                                    root.font_size_changed(root.font_size + 1);
                                                }
                                            }
                                        }

                                        Text {
                                            text: "+";
                                            color: Theme.text_primary;
                                            font-size: 16px;
                                            font-weight: 700;
                                            horizontal-alignment: center;
                                            vertical-alignment: center;
                                        }
                                    }
                                }
                            }
                        }

                        // Opção: Quebra de Linha
                        Rectangle {
                            background: Theme.background;
                            border-radius: 8px;
                            border-width: 1px;
                            border-color: Theme.border;
                            height: 64px;

                            HorizontalLayout {
                                padding-left: 16px;
                                padding-right: 16px;
                                alignment: space-between;

                                VerticalLayout {
                                    alignment: center;
                                    spacing: 4px;
                                    Text {
                                        text: "Quebra Automática de Linha";
                                        color: Theme.text_primary;
                                        font-size: 13px;
                                        font-weight: 600;
                                    }
                                    Text {
                                        text: "Ajustar linhas longas à largura da janela.";
                                        color: Theme.text_muted;
                                        font-size: 11px;
                                    }
                                }

                                Rectangle {
                                    width: 80px;
                                    height: 32px;
                                    border-radius: 6px;
                                    background: root.line_wrapping ? Theme.accent : Theme.surface_hover;

                                    TouchArea {
                                        mouse-cursor: pointer;
                                        clicked => { root.line_wrapping_toggled(); }
                                    }

                                    Text {
                                        text: root.line_wrapping ? "Ativo" : "Inativo";
                                        color: root.line_wrapping ? #ffffff : Theme.text_secondary;
                                        font-size: 12px;
                                        horizontal-alignment: center;
                                        vertical-alignment: center;
                                    }
                                }
                            }
                        }

                        Rectangle {}
                    }

                    // Painel: SOBRE (active_tab_index == 3)
                    if root.active_tab_index == 3: VerticalLayout {
                        spacing: 16px;

                        Rectangle {
                            background: Theme.background;
                            border-radius: 8px;
                            border-width: 1px;
                            border-color: Theme.border;

                            VerticalLayout {
                                padding: 16px;
                                spacing: 10px;

                                HorizontalLayout {
                                    spacing: 12px;
                                    Text {
                                        text: "🌌";
                                        font-size: 24px;
                                        vertical-alignment: center;
                                    }
                                    VerticalLayout {
                                        spacing: 2px;
                                        Text {
                                            text: "Gnosis Knowledge Vault";
                                            color: Theme.text_primary;
                                            font-size: 16px;
                                            font-weight: 700;
                                        }
                                        Text {
                                            text: "Versão: " + root.app_version + " (Compilação Nativa Safe Rust)";
                                            color: Theme.accent;
                                            font-size: 12px;
                                        }
                                    }
                                }

                                Rectangle {
                                    height: 1px;
                                    background: Theme.border;
                                }

                                Text {
                                    text: "• Motor Gráfico: " + root.engine_info;
                                    color: Theme.text_secondary;
                                    font-size: 12px;
                                }
                                Text {
                                    text: "• Filosofia: 100% Safe Rust, sem unwrap em produção, latência de edição < 2ms.";
                                    color: Theme.text_secondary;
                                    font-size: 12px;
                                }
                                Text {
                                    text: "• Compatibilidade Garantida: Hardware de 2015- (60 FPS, sem necessidade de GPU Vulkan).";
                                    color: Theme.text_secondary;
                                    font-size: 12px;
                                }
                                Text {
                                    text: "• Sistema de Arquivos: VFS Híbrido (Desktop nativo e Web WASM).";
                                    color: Theme.text_secondary;
                                    font-size: 12px;
                                }
                            }
                        }

                        Rectangle {}
                    }
                }
            }
        }
    }
}

