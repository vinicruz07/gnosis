import { Theme } from "theme.slint";

export struct RenderBlockData {
    kind: string,
    text: string,
    extra: string,
    is_checked: bool,
    is_editing_math: bool,
}

export component RichViewer inherits Rectangle {
    in property <[RenderBlockData]> blocks: [];
    callback task_toggled(int);
    callback math_clicked(int);
    callback math_applied(int, string);
    callback math_cancelled(int);

    background: Theme.background;

    Flickable {
        vertical-stretch: 1;

        VerticalLayout {
            padding: 16px;
            spacing: 12px;
            alignment: start;

            for block[idx] in root.blocks: Rectangle {
                // H1
                if (block.kind == "h1"): VerticalLayout {
                    spacing: 4px;
                    Text {
                        text: block.text;
                        color: Theme.text_primary;
                        font-size: 24px;
                        font-weight: 700;
                        wrap: word-wrap;
                    }
                    Rectangle {
                        height: 1px;
                        background: Theme.border;
                    }
                }

                // H2
                if (block.kind == "h2"): Text {
                    text: block.text;
                    color: Theme.text_primary;
                    font-size: 19px;
                    font-weight: 600;
                    wrap: word-wrap;
                }

                // H3
                if (block.kind == "h3"): Text {
                    text: block.text;
                    color: Theme.text_secondary;
                    font-size: 16px;
                    font-weight: 600;
                    wrap: word-wrap;
                }

                // Parágrafo Normal
                if (block.kind == "paragraph"): Text {
                    text: block.text;
                    color: Theme.text_secondary;
                    font-size: 14px;
                    wrap: word-wrap;
                }

                // Bloco de Código Estilizado
                if (block.kind == "code"): Rectangle {
                    background: #11111b;
                    border-radius: 6px;
                    border-width: 1px;
                    border-color: Theme.border;

                    VerticalLayout {
                        padding: 10px;
                        spacing: 6px;

                        // Rótulo da Linguagem
                        HorizontalLayout {
                            alignment: end;
                            Text {
                                text: block.extra;
                                color: Theme.text_muted;
                                font-size: 10px;
                                font-weight: 600;
                            }
                        }

                        // Código-fonte
                        Text {
                            text: block.text;
                            color: #a6e3a1; // Verde suave para código
                            font-size: 13px;
                            wrap: word-wrap;
                        }
                    }
                }

                // Callout do Obsidian ([!NOTE], [!TIP], etc.)
                if (block.kind == "callout"): Rectangle {
                    background: Theme.surface;
                    border-radius: 6px;
                    clip: true;

                    // Barra de destaque vertical à esquerda
                    Rectangle {
                        x: 0px;
                        y: 0px;
                        width: 4px;
                        height: 100%;
                        background: Theme.accent;
                    }

                    VerticalLayout {
                        padding: 10px;
                        padding-left: 14px;
                        spacing: 6px;

                        // Título do Callout com Ícone
                        HorizontalLayout {
                            spacing: 6px;
                            alignment: start;

                            Text {
                                text: "💡";
                                font-size: 13px;
                                vertical-alignment: center;
                            }

                            Text {
                                text: block.extra;
                                color: Theme.accent;
                                font-size: 13px;
                                font-weight: 600;
                                vertical-alignment: center;
                            }
                        }

                        // Conteúdo Interno
                        Text {
                            text: block.text;
                            color: Theme.text_secondary;
                            font-size: 13px;
                            wrap: word-wrap;
                        }
                    }
                }

                // Tarefa com Checkbox Interativo
                if (block.kind == "task"): Rectangle {
                    height: 24px;

                    HorizontalLayout {
                        spacing: 8px;
                        alignment: start;

                        // Caixa de seleção
                        Rectangle {
                            width: 16px;
                            height: 16px;
                            border-radius: 4px;
                            border-width: 1px;
                            border-color: block.is_checked ? Theme.accent : Theme.text_muted;
                            background: block.is_checked ? Theme.accent : transparent;
                            y: (parent.height - self.height) / 2;

                            Text {
                                text: block.is_checked ? "✓" : "";
                                color: #11111b;
                                font-size: 11px;
                                font-weight: 700;
                                horizontal-alignment: center;
                                vertical-alignment: center;
                            }

                            TouchArea {
                                clicked => { root.task_toggled(idx); }
                            }
                        }

                        // Texto da Tarefa
                        Text {
                            text: block.text;
                            color: block.is_checked ? Theme.text_muted : Theme.text_primary;
                            font-size: 13px;
                            vertical-alignment: center;
                        }
                    }
                }

                // Citação (Blockquote)
                if (block.kind == "quote"): Rectangle {
                    background: Theme.surface;
                    clip: true;

                    // Barra vertical da citação à esquerda
                    Rectangle {
                        x: 0px;
                        y: 0px;
                        width: 3px;
                        height: 100%;
                        background: Theme.text_muted;
                    }

                    VerticalLayout {
                        padding: 8px;
                        padding-left: 12px;
                        Text {
                            text: block.text;
                            color: Theme.text_secondary;
                            font-size: 13px;
                            font-italic: true;
                            wrap: word-wrap;
                        }
                    }
                }

                // Bloco Matemático Interativo estilo Word ($$ ... $$)
                if (block.kind == "math"): Rectangle {
                    background: block.is_editing_math ? #11111b : Theme.surface;
                    border-radius: 6px;
                    border-width: block.is_editing_math ? 1.5px : 1px;
                    border-color: block.is_editing_math ? Theme.accent : Theme.border;

                    VerticalLayout {
                        padding: 12px;
                        spacing: 8px;

                        // Cabeçalho de Controle e Status da Fórmula
                        HorizontalLayout {
                            alignment: space-between;

                            HorizontalLayout {
                                spacing: 6px;
                                alignment: start;

                                Text {
                                    text: "📐";
                                    font-size: 13px;
                                    vertical-alignment: center;
                                }

                                Text {
                                    text: block.is_editing_math ? "Editor de Equação (LaTeX / Typst)" : "Equação";
                                    color: block.is_editing_math ? Theme.accent : Theme.text_muted;
                                    font-size: 11px;
                                    font-weight: 600;
                                    vertical-alignment: center;
                                }
                            }

                            if (!block.is_editing_math): Text {
                                text: "Clique para editar";
                                color: Theme.text_muted;
                                font-size: 10px;
                                vertical-alignment: center;
                            }
                        }

                        // Modo 1: Repouso Gráfico estilo Word (Nítido, elegante, renderizado)
                        if (!block.is_editing_math): HorizontalLayout {
                            alignment: center;
                            padding-top: 6px;
                            padding-bottom: 6px;

                            Text {
                                text: (block.extra != "") ? block.extra : block.text;
                                color: Theme.text_primary;
                                font-size: 18px;
                                font-italic: true;
                                horizontal-alignment: center;
                                vertical-alignment: center;
                            }
                        }

                        // Modo 2: Edição Interativa estilo Word (TextInput com foco ao vivo e botões no mesmo escopo)
                        if (block.is_editing_math): VerticalLayout {
                            spacing: 8px;

                            math_input := TextInput {
                                text: block.text;
                                color: #89dceb;
                                font-size: 14px;
                                single-line: false;
                                wrap: word-wrap;

                                accepted => {
                                    root.math_applied(idx, self.text);
                                }
                            }

                            HorizontalLayout {
                                alignment: space-between;

                                Text {
                                    text: "Dica: Pressione Enter para aplicar";
                                    color: Theme.text_muted;
                                    font-size: 10px;
                                    vertical-alignment: center;
                                }

                                HorizontalLayout {
                                    spacing: 6px;

                                    // Botão Cancelar
                                    Rectangle {
                                        height: 22px;
                                        border-radius: 4px;
                                        background: touch_mcanc.has-hover ? Theme.surface_hover : transparent;

                                        HorizontalLayout {
                                            padding-left: 8px;
                                            padding-right: 8px;
                                            alignment: center;

                                            Text {
                                                text: "✕ Cancelar";
                                                color: Theme.text_muted;
                                                font-size: 11px;
                                                vertical-alignment: center;
                                            }
                                        }

                                        touch_mcanc := TouchArea {
                                            clicked => { root.math_cancelled(idx); }
                                        }
                                    }

                                    // Botão Aplicar (✓)
                                    Rectangle {
                                        height: 22px;
                                        border-radius: 4px;
                                        background: Theme.accent;

                                        HorizontalLayout {
                                            padding-left: 10px;
                                            padding-right: 10px;
                                            alignment: center;

                                            Text {
                                                text: "✓ Aplicar";
                                                color: #11111b;
                                                font-size: 11px;
                                                font-weight: 700;
                                                vertical-alignment: center;
                                            }
                                        }

                                        TouchArea {
                                            clicked => { root.math_applied(idx, math_input.text); }
                                        }
                                    }
                                }
                            }
                        }
                    }

                    // Se não estiver editando, TouchArea cobre todo o bloco para abrir no clique
                    if (!block.is_editing_math): TouchArea {
                        clicked => { root.math_clicked(idx); }
                    }
                }

                // Divisor Horizontal (---)
                if (block.kind == "divider"): Rectangle {
                    height: 1px;
                    background: Theme.border;
                }
            }
        }
    }
}
