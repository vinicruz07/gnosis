import { Theme } from "theme.slint";

export struct RenderBlockData {
    id: int,
    kind: string,
    text: string,
    raw_text: string,
    extra: string,
    is_checked: bool,
    is_editing: bool,
    is_editing_math: bool,
}

export component RichViewer inherits Rectangle {
    in property <[RenderBlockData]> blocks: [];
    callback task_toggled(int);
    callback math_clicked(int);
    callback math_applied(int, string);
    callback math_cancelled(int);
    callback block_clicked(int);
    callback block_applied(int, string);
    callback block_cancelled(int);
    callback block_enter_pressed(int, string);
    callback block_backspace_pressed(int);
    callback block_navigate_up(int, string);
    callback block_navigate_down(int, string);

    background: Theme.background;

    Flickable {
        vertical-stretch: 1;

        VerticalLayout {
            padding: 16px;
            spacing: 12px;
            alignment: start;

            for block[idx] in root.blocks: Rectangle {
                // Modo Edição In-Place para blocos textuais ativos (H1-H6, Parágrafo, Callout, Citação, Tarefas, Tabelas, Código)
                if (block.is_editing && block.kind != "math"): Rectangle {
                    background: Theme.surface;
                    border-radius: 6px;
                    border-width: 1.5px;
                    border-color: Theme.accent;
                    clip: true;

                    VerticalLayout {
                        padding: 10px;
                        spacing: 8px;

                        block_input := TextInput {
                            text: block.raw_text;
                            color: Theme.text_primary;
                            font-size: 14px;
                            single-line: false;
                            wrap: word-wrap;

                            accepted => {
                                root.block_enter_pressed(block.id, self.text);
                            }
                        }

                        HorizontalLayout {
                            alignment: space-between;

                            // Ferramentas de navegação contínua por bloco (Live Preview Flow)
                            HorizontalLayout {
                                spacing: 6px;

                                // Botão Navegar Bloco Anterior (↑)
                                Rectangle {
                                    height: 22px;
                                    border-radius: 4px;
                                    background: touch_bprev.has-hover ? Theme.surface_hover : transparent;

                                    HorizontalLayout {
                                        padding-left: 6px;
                                        padding-right: 6px;
                                        alignment: center;
                                        Text {
                                            text: "↑ Anterior";
                                            color: Theme.text_muted;
                                            font-size: 11px;
                                            vertical-alignment: center;
                                        }
                                    }

                                    touch_bprev := TouchArea {
                                        clicked => { root.block_navigate_up(block.id, block_input.text); }
                                    }
                                }

                                // Botão Navegar Próximo Bloco (↓)
                                Rectangle {
                                    height: 22px;
                                    border-radius: 4px;
                                    background: touch_bnext.has-hover ? Theme.surface_hover : transparent;

                                    HorizontalLayout {
                                        padding-left: 6px;
                                        padding-right: 6px;
                                        alignment: center;
                                        Text {
                                            text: "↓ Próximo";
                                            color: Theme.text_muted;
                                            font-size: 11px;
                                            vertical-alignment: center;
                                        }
                                    }

                                    touch_bnext := TouchArea {
                                        clicked => { root.block_navigate_down(block.id, block_input.text); }
                                    }
                                }

                                // Botão Novo Bloco Abaixo (Enter)
                                Rectangle {
                                    height: 22px;
                                    border-radius: 4px;
                                    background: touch_benter.has-hover ? Theme.surface_hover : transparent;

                                    HorizontalLayout {
                                        padding-left: 6px;
                                        padding-right: 6px;
                                        alignment: center;
                                        Text {
                                            text: "↵ Novo Bloco";
                                            color: Theme.accent;
                                            font-size: 11px;
                                            vertical-alignment: center;
                                        }
                                    }

                                    touch_benter := TouchArea {
                                        clicked => { root.block_enter_pressed(block.id, block_input.text); }
                                    }
                                }

                                // Botão Unir / Deletar Bloco Vazio (Backspace)
                                Rectangle {
                                    height: 22px;
                                    border-radius: 4px;
                                    background: touch_bdel.has-hover ? #450a0a : transparent;

                                    HorizontalLayout {
                                        padding-left: 6px;
                                        padding-right: 6px;
                                        alignment: center;
                                        Text {
                                            text: "⌫ Deletar / Unir";
                                            color: #f38ba8;
                                            font-size: 11px;
                                            vertical-alignment: center;
                                        }
                                    }

                                    touch_bdel := TouchArea {
                                        clicked => { root.block_backspace_pressed(block.id); }
                                    }
                                }
                            }

                            // Ações de confirmação
                            HorizontalLayout {
                                spacing: 6px;

                                // Botão Cancelar
                                Rectangle {
                                    height: 22px;
                                    border-radius: 4px;
                                    background: touch_bcanc.has-hover ? Theme.surface_hover : transparent;

                                    HorizontalLayout {
                                        padding-left: 8px;
                                        padding-right: 8px;
                                        alignment: center;

                                        Text {
                                            text: "✕ Cancelar";
                                            color: Theme.text_muted;
                                            font-size: 11px;
                                            vertical-alignment: center;
                                        }
                                    }

                                    touch_bcanc := TouchArea {
                                        clicked => { root.block_cancelled(block.id); }
                                    }
                                }

                                // Botão Concluir / Aplicar (✓)
                                Rectangle {
                                    height: 22px;
                                    border-radius: 4px;
                                    background: Theme.accent;

                                    HorizontalLayout {
                                        padding-left: 10px;
                                        padding-right: 10px;
                                        alignment: center;

                                        Text {
                                            text: "✓ Concluir";
                                            color: #11111b;
                                            font-size: 11px;
                                            font-weight: 700;
                                            vertical-alignment: center;
                                        }
                                    }

                                    TouchArea {
                                        clicked => { root.block_applied(block.id, block_input.text); }
                                    }
                                }
                            }
                        }
                    }
                }

                // H1 em repouso
                if (!block.is_editing && block.kind == "h1"): Rectangle {
                    background: touch_h1.has-hover ? Theme.surface_hover : transparent;
                    border-radius: 4px;

                    VerticalLayout {
                        padding: 4px;
                        spacing: 4px;
                        Text {
                            text: block.text;
                            color: Theme.text_primary;
                            font-size: 24px;
                            font-weight: 700;
                            wrap: word-wrap;
                        }
                        Rectangle {
                            height: 1px;
                            background: Theme.border;
                        }
                    }

                    touch_h1 := TouchArea {
                        clicked => { root.block_clicked(block.id); }
                    }
                }

                // H2 em repouso
                if (!block.is_editing && block.kind == "h2"): Rectangle {
                    background: touch_h2.has-hover ? Theme.surface_hover : transparent;
                    border-radius: 4px;

                    HorizontalLayout {
                        padding: 4px;
                        Text {
                            text: block.text;
                            color: Theme.text_primary;
                            font-size: 19px;
                            font-weight: 600;
                            wrap: word-wrap;
                        }
                    }

                    touch_h2 := TouchArea {
                        clicked => { root.block_clicked(block.id); }
                    }
                }

                // H3 em repouso
                if (!block.is_editing && block.kind == "h3"): Rectangle {
                    background: touch_h3.has-hover ? Theme.surface_hover : transparent;
                    border-radius: 4px;

                    HorizontalLayout {
                        padding: 4px;
                        Text {
                            text: block.text;
                            color: Theme.text_secondary;
                            font-size: 16px;
                            font-weight: 600;
                            wrap: word-wrap;
                        }
                    }

                    touch_h3 := TouchArea {
                        clicked => { root.block_clicked(block.id); }
                    }
                }

                // H4, H5, H6 em repouso
                if (!block.is_editing && (block.kind == "h4" || block.kind == "h5" || block.kind == "h6")): Rectangle {
                    background: touch_hx.has-hover ? Theme.surface_hover : transparent;
                    border-radius: 4px;

                    HorizontalLayout {
                        padding: 4px;
                        Text {
                            text: block.text;
                            color: Theme.text_secondary;
                            font-size: 14px;
                            font-weight: 600;
                            wrap: word-wrap;
                        }
                    }

                    touch_hx := TouchArea {
                        clicked => { root.block_clicked(block.id); }
                    }
                }

                // Parágrafo Normal em repouso
                if (!block.is_editing && block.kind == "paragraph"): Rectangle {
                    background: touch_p.has-hover ? Theme.surface_hover : transparent;
                    border-radius: 4px;

                    HorizontalLayout {
                        padding: 4px;
                        Text {
                            text: block.text;
                            color: Theme.text_secondary;
                            font-size: 14px;
                            wrap: word-wrap;
                        }
                    }

                    touch_p := TouchArea {
                        clicked => { root.block_clicked(block.id); }
                    }
                }

                // Bloco de Código Estilizado em repouso
                if (!block.is_editing && block.kind == "code"): Rectangle {
                    background: touch_code.has-hover ? #181825 : #11111b;
                    border-radius: 6px;
                    border-width: 1px;
                    border-color: touch_code.has-hover ? Theme.accent : Theme.border;

                    VerticalLayout {
                        padding: 10px;
                        spacing: 6px;

                        // Rótulo da Linguagem
                        HorizontalLayout {
                            alignment: space-between;
                            Text {
                                text: "💻 " + block.extra;
                                color: Theme.accent;
                                font-size: 10px;
                                font-weight: 600;
                            }
                            Text {
                                text: "Clique para editar";
                                color: Theme.text_muted;
                                font-size: 10px;
                            }
                        }

                        // Código-fonte
                        Text {
                            text: block.text;
                            color: #a6e3a1; // Verde suave para código
                            font-size: 13px;
                            wrap: word-wrap;
                        }
                    }

                    touch_code := TouchArea {
                        clicked => { root.block_clicked(block.id); }
                    }
                }

                // Callout do Obsidian ([!NOTE], [!TIP], etc.) em repouso
                if (!block.is_editing && block.kind == "callout"): Rectangle {
                    background: touch_callout.has-hover ? Theme.surface_hover : Theme.surface;
                    border-radius: 6px;
                    clip: true;

                    // Barra de destaque vertical à esquerda
                    Rectangle {
                        x: 0px;
                        y: 0px;
                        width: 4px;
                        height: 100%;
                        background: Theme.accent;
                    }

                    VerticalLayout {
                        padding: 10px;
                        padding-left: 14px;
                        spacing: 6px;

                        // Título do Callout com Ícone
                        HorizontalLayout {
                            spacing: 6px;
                            alignment: start;

                            Text {
                                text: "💡";
                                font-size: 13px;
                                vertical-alignment: center;
                            }

                            Text {
                                text: block.extra;
                                color: Theme.accent;
                                font-size: 13px;
                                font-weight: 600;
                                vertical-alignment: center;
                            }
                        }

                        // Conteúdo Interno
                        Text {
                            text: block.text;
                            color: Theme.text_secondary;
                            font-size: 13px;
                            wrap: word-wrap;
                        }
                    }

                    touch_callout := TouchArea {
                        clicked => { root.block_clicked(block.id); }
                    }
                }

                // Tarefa com Checkbox Interativo em repouso
                if (!block.is_editing && block.kind == "task"): Rectangle {
                    height: 26px;

                    HorizontalLayout {
                        spacing: 8px;
                        alignment: start;

                        // Caixa de seleção
                        Rectangle {
                            width: 18px;
                            height: 18px;
                            border-radius: 4px;
                            border-width: 1px;
                            border-color: block.is_checked ? Theme.accent : Theme.text_muted;
                            background: block.is_checked ? Theme.accent : transparent;
                            y: (parent.height - self.height) / 2;

                            Text {
                                text: block.is_checked ? "✓" : "";
                                color: #11111b;
                                font-size: 12px;
                                font-weight: 700;
                                horizontal-alignment: center;
                                vertical-alignment: center;
                            }

                            TouchArea {
                                clicked => { root.task_toggled(block.id); }
                            }
                        }

                        // Texto da Tarefa com clique para editar
                        Rectangle {
                            horizontal-stretch: 1;
                            background: touch_task_txt.has-hover ? Theme.surface_hover : transparent;
                            border-radius: 4px;

                            HorizontalLayout {
                                padding-left: 6px;
                                padding-right: 6px;

                                Text {
                                    text: block.text;
                                    color: block.is_checked ? Theme.text_muted : Theme.text_primary;
                                    font-size: 13px;
                                    vertical-alignment: center;
                                }
                            }

                            touch_task_txt := TouchArea {
                                clicked => { root.block_clicked(block.id); }
                            }
                        }
                    }
                }

                // Citação (Blockquote) em repouso
                if (!block.is_editing && block.kind == "quote"): Rectangle {
                    background: touch_quote.has-hover ? Theme.surface_hover : Theme.surface;
                    border-radius: 6px;
                    clip: true;

                    // Barra vertical da citação à esquerda
                    Rectangle {
                        x: 0px;
                        y: 0px;
                        width: 3px;
                        height: 100%;
                        background: Theme.text_muted;
                    }

                    VerticalLayout {
                        padding: 8px;
                        padding-left: 14px;
                        Text {
                            text: block.text;
                            color: Theme.text_secondary;
                            font-size: 13px;
                            font-italic: true;
                            wrap: word-wrap;
                        }
                    }

                    touch_quote := TouchArea {
                        clicked => { root.block_clicked(block.id); }
                    }
                }

                // Tabela Markdown em repouso
                if (!block.is_editing && block.kind == "table"): Rectangle {
                    background: touch_tbl.has-hover ? Theme.surface_hover : Theme.surface;
                    border-radius: 6px;
                    border-width: 1px;
                    border-color: Theme.border;

                    VerticalLayout {
                        padding: 10px;
                        spacing: 6px;

                        HorizontalLayout {
                            alignment: space-between;
                            Text {
                                text: "📊 Tabela";
                                color: Theme.accent;
                                font-size: 11px;
                                font-weight: 600;
                            }
                            Text {
                                text: "Clique para editar";
                                color: Theme.text_muted;
                                font-size: 10px;
                            }
                        }

                        Text {
                            text: block.text;
                            color: Theme.text_primary;
                            font-size: 13px;
                            wrap: word-wrap;
                        }
                    }

                    touch_tbl := TouchArea {
                        clicked => { root.block_clicked(block.id); }
                    }
                }

                // Bloco Matemático Interativo estilo Word ($$ ... $$)
                if (block.kind == "math"): Rectangle {
                    background: block.is_editing_math ? #11111b : Theme.surface;
                    border-radius: 6px;
                    border-width: block.is_editing_math ? 1.5px : 1px;
                    border-color: block.is_editing_math ? Theme.accent : Theme.border;

                    VerticalLayout {
                        padding: 12px;
                        spacing: 8px;

                        // Cabeçalho de Controle e Status da Fórmula
                        HorizontalLayout {
                            alignment: space-between;

                            HorizontalLayout {
                                spacing: 6px;
                                alignment: start;

                                Text {
                                    text: "📐";
                                    font-size: 13px;
                                    vertical-alignment: center;
                                }

                                Text {
                                    text: block.is_editing_math ? "Editor de Equação (LaTeX / Typst)" : "Equação";
                                    color: block.is_editing_math ? Theme.accent : Theme.text_muted;
                                    font-size: 11px;
                                    font-weight: 600;
                                    vertical-alignment: center;
                                }
                            }

                            if (!block.is_editing_math): Text {
                                text: "Clique para editar";
                                color: Theme.text_muted;
                                font-size: 10px;
                                vertical-alignment: center;
                            }
                        }

                        // Modo 1: Repouso Gráfico estilo Word (Nítido, elegante, renderizado)
                        if (!block.is_editing_math): HorizontalLayout {
                            alignment: center;
                            padding-top: 6px;
                            padding-bottom: 6px;

                            Text {
                                text: (block.extra != "") ? block.extra : block.text;
                                color: Theme.text_primary;
                                font-size: 18px;
                                font-italic: true;
                                horizontal-alignment: center;
                                vertical-alignment: center;
                            }
                        }

                        // Modo 2: Edição Interativa estilo Word (TextInput com foco ao vivo e botões no mesmo escopo)
                        if (block.is_editing_math): VerticalLayout {
                            spacing: 8px;

                            math_input := TextInput {
                                text: block.text;
                                color: #89dceb;
                                font-size: 14px;
                                single-line: false;
                                wrap: word-wrap;

                                accepted => {
                                    root.math_applied(idx, self.text);
                                }
                            }

                            HorizontalLayout {
                                alignment: space-between;

                                Text {
                                    text: "Dica: Pressione Enter para aplicar";
                                    color: Theme.text_muted;
                                    font-size: 10px;
                                    vertical-alignment: center;
                                }

                                HorizontalLayout {
                                    spacing: 6px;

                                    // Botão Cancelar
                                    Rectangle {
                                        height: 22px;
                                        border-radius: 4px;
                                        background: touch_mcanc.has-hover ? Theme.surface_hover : transparent;

                                        HorizontalLayout {
                                            padding-left: 8px;
                                            padding-right: 8px;
                                            alignment: center;

                                            Text {
                                                text: "✕ Cancelar";
                                                color: Theme.text_muted;
                                                font-size: 11px;
                                                vertical-alignment: center;
                                            }
                                        }

                                        touch_mcanc := TouchArea {
                                            clicked => { root.math_cancelled(idx); }
                                        }
                                    }

                                    // Botão Aplicar (✓)
                                    Rectangle {
                                        height: 22px;
                                        border-radius: 4px;
                                        background: Theme.accent;

                                        HorizontalLayout {
                                            padding-left: 10px;
                                            padding-right: 10px;
                                            alignment: center;

                                            Text {
                                                text: "✓ Aplicar";
                                                color: #11111b;
                                                font-size: 11px;
                                                font-weight: 700;
                                                vertical-alignment: center;
                                            }
                                        }

                                        TouchArea {
                                            clicked => { root.math_applied(idx, math_input.text); }
                                        }
                                    }
                                }
                            }
                        }
                    }

                    // Se não estiver editando, TouchArea cobre todo o bloco para abrir no clique
                    if (!block.is_editing_math): TouchArea {
                        clicked => { root.math_clicked(idx); }
                    }
                }

                // Divisor Horizontal (---)
                if (block.kind == "divider"): Rectangle {
                    height: 1px;
                    background: Theme.border;
                }
            }
        }
    }
}
